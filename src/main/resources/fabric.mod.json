		"issues": "https://github.com/YOUR-NAME/spotifylyrics/issues"
	},
	"license": "MIT",
	"icon": "assets/spotifylyrics/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.spotifylyrics.SpotifyLyricsMod"]
	},
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
